#--------------------------------------------------------------------
# Norlanka Web — environment template. Copy to `.env` and adjust.
#--------------------------------------------------------------------

# development | testing | production
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# --- Option A: SQLite (zero infra, great for local dev) ---
# Filename only — CodeIgniter stores it under writable/.
database.default.DBDriver = SQLite3
database.default.database = norlanka.db
database.default.foreignKeys = true

# --- Option B: MySQL 8 (Docker / production) ---
# database.default.DBDriver = MySQLi
# database.default.hostname = mysql
# database.default.database = norlanka
# database.default.username = norlanka
# database.default.password = secret
# database.default.port = 3306
# database.default.charset = utf8mb4
# database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# ENCRYPTION  (run: php spark key:generate)
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# REDIS / CACHE
#--------------------------------------------------------------------
cache.handler = file
# cache.handler = redis
redis.host = 127.0.0.1
redis.port = 6379
redis.password =

#--------------------------------------------------------------------
# JWT (Auth module)
#--------------------------------------------------------------------
jwt.secret = 'please-change-this-to-a-long-random-secret'
jwt.ttl = 3600
jwt.issuer = 'norlanka'

#--------------------------------------------------------------------
# THIRD-PARTY
#--------------------------------------------------------------------
ga4.measurementId = ''
# aws.s3.bucket =
# aws.s3.region =
# meilisearch.host = http://meilisearch:7700
# meilisearch.masterKey =
