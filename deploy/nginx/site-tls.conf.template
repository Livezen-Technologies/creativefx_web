# Generic Nginx server block — HTTPS, used when a Let's Encrypt certificate for
# the domain already exists. deploy/setup.sh fills in {{DOMAIN}}, {{APP_DIR}},
# {{PHP_FPM_SOCK}} and {{SLUG}}.
#
# managed-by: norlanka-deploy
# Scoped to this domain only — name-based, never a default_server, so other
# sites on the box keep serving their own certs untouched.
#
# Works both for visitors hitting this box directly and for a TLS-terminating
# proxy in front of it (Cloudflare). With Cloudflare's SSL mode set to
# "Flexible" the edge speaks HTTPS to the visitor but fetches the origin over
# plain :80 — so an unconditional :80 -> :443 redirect bounces the visitor back
# and forth until the browser gives up ("too many redirects"). The scheme the
# VISITOR used arrives in X-Forwarded-Proto, so trust that when it is present
# and fall back to the connection's own scheme when it is not.

map $http_x_forwarded_proto $scheme_{{SLUG}} {
    default $scheme;      # direct hit — believe the connection
    https   https;        # proxied, visitor was on HTTPS
    http    http;         # proxied, visitor was on HTTP
}

# CodeIgniter reads $_SERVER['HTTPS']; empty means "not secure".
map $scheme_{{SLUG}} $fcgi_https_{{SLUG}} {
    default '';
    https   on;
}

server {
    listen 80;
    listen [::]:80;
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{DOMAIN}};

    ssl_certificate     /etc/letsencrypt/live/{{DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{DOMAIN}}/privkey.pem;
    # Inlined modern TLS settings (no external include — keeps `nginx -t` from
    # depending on certbot's options file existing).
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    # Zone name carries the slug: two sites sharing one name would clash.
    ssl_session_cache shared:ssl_{{SLUG}}:10m;
    ssl_session_timeout 1d;

    root {{APP_DIR}}/public;
    index index.php;

    client_max_body_size 64M;

    # Send a genuinely plaintext visitor to HTTPS. A proxied request that was
    # already HTTPS at the edge falls through and is served, which is what
    # breaks the redirect loop.
    if ($scheme_{{SLUG}} != https) {
        return 301 https://$host$request_uri;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:{{PHP_FPM_SOCK}};
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        # Tell the app the VISITOR's scheme, so it builds https:// URLs even
        # when the edge reached us over plain http.
        fastcgi_param HTTPS $fcgi_https_{{SLUG}};
    }

    location /build/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /media/ {
        expires 30d;
        try_files $uri =404;
    }

    location ~ /\.(?!well-known) { deny all; }
    location ~* /(app|system|writable|vendor|tests|deploy)/ { deny all; }

    access_log /var/log/nginx/{{SLUG}}.access.log;
    error_log  /var/log/nginx/{{SLUG}}.error.log;
}
