#--------------------------------------------------------------------
# Norlanka Web — PRODUCTION environment template.
# setup.sh generates the real .env on the server (with real DB password,
# encryption key and JWT secret). Never commit a filled-in copy.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'https://norlankamfg.livezencloud.com/'
app.indexPage = ''
# Enable ONLY once TLS reaches the origin (Cloudflare Full/Full-strict or certbot).
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE (MySQL 8)
#--------------------------------------------------------------------
database.default.DBDriver = MySQLi
database.default.hostname = 127.0.0.1
database.default.database = norlanka
database.default.username = norlanka
database.default.password = '__GENERATED_ON_SERVER__'
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# ENCRYPTION  (php spark key:generate writes this)
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# CACHE / REDIS  (file cache by default; switch to redis if available)
#--------------------------------------------------------------------
cache.handler = file
redis.host = 127.0.0.1
redis.port = 6379
redis.password =

#--------------------------------------------------------------------
# JWT (Auth module) — generated on the server
#--------------------------------------------------------------------
jwt.secret = '__GENERATED_ON_SERVER__'
jwt.ttl = 3600
jwt.issuer = 'norlanka'

#--------------------------------------------------------------------
# MAINTENANCE MODE
#--------------------------------------------------------------------
# Normally left commented out — Admin -> Maintenance and
# `php spark maintenance on|off` are the day-to-day switch. Uncomment only to
# override them from the server (`true` = offline, `false` = live).
# maintenance.enabled = true

#--------------------------------------------------------------------
# THIRD-PARTY
#--------------------------------------------------------------------
ga4.measurementId = ''
